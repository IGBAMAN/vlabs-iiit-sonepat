{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vitest/globals"],
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/sections/**/*.ts",
    "src/sections/**/*.tsx",
    "src/ui/**/*.ts",
    "src/ui/**/*.tsx",
    "src/tokens/**/*.ts",
    "src/icons/**/*.ts",
    "src/icons/**/*.tsx",
    "src/labs/**/*.ts",
    "src/labs/**/*.tsx",
    "src/components/**/*.ts",
    "src/platform/i18n/**/*.ts",
    "src/platform/menu-style/**/*.ts",
    "src/platform/menu-style/**/*.tsx",
    "src/platform/motion/**/*.ts",
    "src/platform/motion/**/*.tsx",
    "src/platform/visuals/**/*.ts",
    "src/platform/visuals/**/*.tsx",
    "src/platform/site-urls.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
